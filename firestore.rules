rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user matches admin email (MVP auth rule)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'shubhamrajput7667@gmail.com' ||
        request.auth.token.email == 'ayush00ansh@gmail.com'
      );
    }

    // 1. Workers Collection
    match /workers/{workerId} {
      allow create: if true;
      allow get: if true; // Allow direct document fetch (e.g. for detail tracking)
      allow list: if isAdmin(); // Block public listing of all workers
      // Admin has full control. Unauthenticated worker portal updates must not touch credentials or status.
      allow update: if isAdmin() || (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['password', 'mobile', 'name', 'experience', 'serviceType', 'status'])
      );
      allow delete: if isAdmin();
    }

    // 2. Bookings (Leads) Collection
    match /bookings/{bookingId} {
      allow create: if true;
      // Allow read only if document contains associated customer/worker info
      allow read: if isAdmin() || resource.data.assignedWorkerId != null || resource.data.customerMobile != null;
      // Admin has full update capability. Worker/Customer updates cannot modify billing or core service info.
      allow update: if isAdmin() || (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['price', 'serviceType', 'customerMobile', 'paymentStatus'])
      );
      allow delete: if isAdmin();
    }

    // 3. Customers Collection
    match /customers/{customerId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // 4. Reviews Collection
    match /reviews/{reviewId} {
      // Anyone can post feedback; only admins can list reviews in dash
      allow create: if true;
      allow read: if isAdmin() || resource.data.workerId != null;
      allow write: if isAdmin();
    }

    // 5. Payments Collection
    match /payments/{paymentId} {
      // Create payment log on successful Razorpay checkout
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // 6. Complaints Collection
    match /complaints/{complaintId} {
      allow create: if true;
      allow read: if isAdmin() || resource.data.workerId != null || resource.data.customerMobile != null;
      allow update: if isAdmin() || (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerName', 'customerMobile', 'workerId'])
      );
      allow delete: if isAdmin();
    }

    // 7. Admin Logs
    match /admin_logs/{logId} {
      allow create: if isAdmin();
      allow read, write: if isAdmin();
    }

    // 8. Services Collection
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Shops Collection
    match /shops/{shopId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Vehicles Collection
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. System Config Collection
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. Launch Interests — anyone can register interest (public form)
    match /launch_interests/{interestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 13. Waitlist Collection — public can register, admin has full access
    match /waitlist/{waitlistId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 14. Hall of Fame Collection — public can read, only admin can write
    match /hall_of_fame/{archiveId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

